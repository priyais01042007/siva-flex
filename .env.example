# ==============================================================================
# Siva Flex Palani - Production Environment Configuration
# Configure these variables in your Netlify Site Configuration (Environment Variables)
# ==============================================================================

# PostgreSQL Connection String (Supabase / Supabase Pooler)
# Note: Use Transaction pooler (port 6543) or Session pooler (port 5432)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Supabase Storage & Client API Configuration
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Custom Session Encryption Secret (Min 32 characters random string)
SESSION_SECRET=your-random-32-character-or-64-hex-session-secret

# Node Environment
NODE_ENV=production
